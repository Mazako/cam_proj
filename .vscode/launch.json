{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug Camwatch: local",
      "cargo": {
        "args": ["build", "-p", "camwatch-server", "--bin", "camwatch-server"],
        "filter": {
          "name": "camwatch-server",
          "kind": "bin"
        }
      },
      "args": [
        "--config",
        "${workspaceFolder}/config/camwatch-local.toml"
      ],
      "sourceLanguages": ["rust"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
